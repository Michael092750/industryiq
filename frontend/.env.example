# Backend API base URL. Defaults to http://localhost:8000 if unset.
# For a deployed backend, set this to its address, e.g. http://1.2.3.4:8000
VITE_API_URL=http://localhost:8000

# Env-file switching (Vite loads these by mode, mode-specific wins):
#   .env.local       -> local dev  (`npm run dev`),  gitignored
#   .env.production  -> AWS deploy (`npm run build`), committed
# So the AWS backend URL lives in .env.production and swaps in automatically
# at build time; nothing to change by hand when deploying.
